# Copy this file to .env.local and fill in real values from your Supabase
# project settings. Never commit .env.local.

# Public — safe to expose in the browser bundle. These only allow access
# governed by Row Level Security (see supabase/migrations/0007_row_level_
# security.sql); they never bypass it.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# SERVER-ONLY. This key bypasses Row Level Security entirely. Never
# prefix it with NEXT_PUBLIC_, never import lib/supabase/admin.ts from a
# "use client" component, and never log or return it in an API response.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
